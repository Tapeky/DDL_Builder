generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogSnapshot {
  id            String   @id
  clientVersion Int
  heroes        Json
  items         Json
  importedAt    DateTime @default(now())
  head          CatalogHead?
  builds        SavedBuild[]
  editorialVersions EditorialBuildVersion[]
  tacticalProfiles TacticalHeroProfile[]
  analyticsRuns AnalyticsRun[]
  leaderboardRuns LeaderboardRun[]
  referenceStatRuns ReferenceStatRun[]
  patchesFrom   PatchChange[] @relation("PatchFrom")
  patchesTo     PatchChange[] @relation("PatchTo")
}

model CatalogHead {
  id         String          @id
  snapshotId String          @unique
  snapshot   CatalogSnapshot @relation(fields: [snapshotId], references: [id])
  checkedAt  DateTime
}

model SavedBuild {
  id         String          @id
  snapshotId String
  snapshot   CatalogSnapshot @relation(fields: [snapshotId], references: [id])
  payload    Json
  createdAt  DateTime        @default(now())
}

model EditorialBuild {
  id         String                  @id
  heroId     Int
  style      String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  versions   EditorialBuildVersion[]

  @@unique([heroId, style])
  @@index([heroId])
}

model EditorialBuildVersion {
  id           String                  @id
  buildId      String
  snapshotId   String
  revision     Int
  title        String
  summary      String
  status       String
  isCurrent    Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  reviewedAt   DateTime?
  build        EditorialBuild          @relation(fields: [buildId], references: [id])
  snapshot     CatalogSnapshot         @relation(fields: [snapshotId], references: [id])
  steps        EditorialBuildStep[]
  investments  EditorialBuildInvestment[]

  @@unique([buildId, snapshotId, revision])
  @@index([buildId, snapshotId, isCurrent])
  @@index([snapshotId, status])
}

model EditorialBuildInvestment {
  id          String                  @id
  versionId   String
  branch      String
  phase       String
  threshold   Int
  priority    String
  reason      String
  version     EditorialBuildVersion  @relation(fields: [versionId], references: [id])

  @@unique([versionId, branch, phase, threshold])
  @@index([versionId, priority])
}

model EditorialBuildStep {
  id          String                           @id
  versionId   String
  order       Int
  phase       String
  itemClassName String
  reason      String
  version     EditorialBuildVersion           @relation(fields: [versionId], references: [id])
  alternatives EditorialBuildStepAlternative[]

  @@unique([versionId, order])
}

model EditorialBuildStepAlternative {
  id          String             @id
  stepId      String
  itemClassName String
  reason      String?
  step        EditorialBuildStep @relation(fields: [stepId], references: [id])

  @@unique([stepId, itemClassName])
}

model PatchChange {
  id              String          @id
  fromSnapshotId  String?
  toSnapshotId    String
  fromClientVersion Int?
  toClientVersion Int
  changedHeroes   Json
  changedItems    Json
  staleBuilds     Json
  createdAt       DateTime        @default(now())
  fromSnapshot    CatalogSnapshot? @relation("PatchFrom", fields: [fromSnapshotId], references: [id])
  toSnapshot      CatalogSnapshot  @relation("PatchTo", fields: [toSnapshotId], references: [id])

  @@index([toSnapshotId])
  @@index([createdAt])
}

model SyncRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  clientVersion Int?
  errorCode     String?
}

model ReferencePlayer {
  id                  String   @id
  displayName         String
  region              String
  accountIds          Json
  heroIds             Json
  verificationStatus  String
  verificationSource  String
  verifiedAt          DateTime?
  lastSeenAt          DateTime?
  sourceUrl           String?
  notes               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  heroStats           ReferenceHeroStat[]

  @@index([verificationStatus, region])
}

model ReferenceStatRun {
  id          String              @id
  snapshotId  String
  heroId      Int
  status      String
  source      String
  filters     Json
  playerCount Int?
  rowCount    Int?
  errorCode   String?
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  snapshot    CatalogSnapshot     @relation(fields: [snapshotId], references: [id])
  stats       ReferenceHeroStat[]

  @@index([snapshotId, heroId, status, completedAt])
}

model ReferenceHeroStat {
  id                String           @id
  runId             String
  referencePlayerId String
  accountId         BigInt
  heroId            Int
  matchesPlayed     BigInt
  wins              BigInt
  lastPlayed        Int
  timePlayed        BigInt
  killsPerMin       Float
  deathsPerMin      Float
  assistsPerMin     Float
  networthPerMin    Float
  damagePerMin      Float
  run               ReferenceStatRun @relation(fields: [runId], references: [id])
  referencePlayer   ReferencePlayer  @relation(fields: [referencePlayerId], references: [id])

  @@unique([runId, referencePlayerId, accountId, heroId])
  @@index([referencePlayerId, heroId, matchesPlayed])
}

model LeaderboardRun {
  id          String                @id
  snapshotId  String
  heroId      Int
  region      String
  status      String
  source      String
  rowCount    Int?
  errorCode   String?
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  snapshot    CatalogSnapshot       @relation(fields: [snapshotId], references: [id])
  candidates  LeaderboardCandidate[]

  @@index([snapshotId, heroId, region])
  @@index([status, completedAt])
}

model LeaderboardCandidate {
  id                  String          @id
  runId               String
  accountName         String?
  possibleAccountIds  Json
  rank                Int?
  topHeroIds          Json
  status              String          @default("pending")
  promotedPlayerId    String?
  run                 LeaderboardRun  @relation(fields: [runId], references: [id])

  @@index([runId, status])
  @@index([accountName])
}

model AnalyticsRun {
  id             String          @id
  snapshotId     String
  metric         String
  status         String
  source         String
  filterHash     String
  filters        Json
  rowCount       Int?
  errorCode      String?
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  snapshot       CatalogSnapshot @relation(fields: [snapshotId], references: [id])
  itemStats      AnalyticsItemStat[]

  @@index([snapshotId, metric, filterHash])
  @@index([snapshotId, status])
  @@index([completedAt])
}

model AnalyticsItemStat {
  id                    String       @id
  runId                 String
  itemId                BigInt
  bucket                Int
  wins                  BigInt
  losses               BigInt
  matches               BigInt
  players               BigInt
  avgBuyTimeS           Float
  avgSellTimeS          Float
  avgBuyTimeRelative    Float
  avgSellTimeRelative   Float
  run                   AnalyticsRun @relation(fields: [runId], references: [id])

  @@unique([runId, itemId, bucket])
  @@index([itemId, matches])
}

model TacticalTagDefinition {
  key         String              @id
  label       String
  description String
  active      Boolean             @default(true)
  assignments TacticalHeroTag[]
}

model TacticalHeroProfile {
  id         String             @id
  snapshotId String
  heroId     Int
  status     String
  source     String
  snapshot   CatalogSnapshot    @relation(fields: [snapshotId], references: [id])
  tags       TacticalHeroTag[]

  @@unique([snapshotId, heroId])
  @@index([snapshotId, status])
}

model TacticalHeroTag {
  id         String                @id
  profileId  String
  tagKey     String
  intensity  Int
  evidence   String
  status     String
  profile    TacticalHeroProfile   @relation(fields: [profileId], references: [id])
  tag        TacticalTagDefinition @relation(fields: [tagKey], references: [key])

  @@unique([profileId, tagKey])
  @@index([tagKey, status])
}
