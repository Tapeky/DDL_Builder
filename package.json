{
  "name": "deadlock-builder",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @deadlock/api --filter @deadlock/web dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "start": "pnpm --parallel --filter @deadlock/api --filter @deadlock/web start",
    "build": "pnpm --filter @deadlock/api build && pnpm --filter @deadlock/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages tests playwright.config.ts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @deadlock/api test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @deadlock/api db:generate",
    "db:migrate": "pnpm --filter @deadlock/api db:migrate",
    "data:sync": "pnpm --filter @deadlock/api data:sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
